# Copie para `.env` (cp .env.example .env). O arquivo `.env` NÃO deve ir para o Git.

# --- Banco de dados ---
POSTGRES_DB=alerta
POSTGRES_USER=alerta
# TROQUE em qualquer ambiente acessível pela internet.
POSTGRES_PASSWORD=alerta_dev

# --- Túnel da Cloudflare (link público aleatório para o app) ---
# "tunnel" = liga o túnel junto com `docker compose up`. Deixe vazio para NÃO expor a API.
COMPOSE_PROFILES=tunnel
# Endereço fixo da API (túnel nomeado/domínio próprio). Vazio = usar o link aleatório do túnel.
PUBLIC_URL=

# --- API e painel ---
API_PORT=8000
# Interface em que a API escuta no computador. Mantenha 127.0.0.1 (o túnel chega por dentro).
API_BIND=127.0.0.1
# Painel em tempo real: http://localhost:8080 (só neste computador).
PAINEL_PORT=8080

# Token do painel e da exportação CSV (GET /respostas/export.csv, cabeçalho X-Admin-Token).
# Vazio = painel sem senha (aceitável só porque ele escuta em 127.0.0.1) e exportação DESATIVADA. Gere um valor forte, ex.: openssl rand -hex 24
ADMIN_TOKEN=

# Segundos em que a resposta do INPE é reaproveitada antes de nova consulta.
INPE_CACHE_SECONDS=300

# Envios por minuto por origem em POST /respostas (0 = sem limite; use o proxy reverso).
RATE_LIMIT_PER_MIN=30

# Mínimo de respostas no período para divulgar estatísticas (evita expor registros individuais).
MIN_RESPOSTAS_PUBLICAS=5

# Mínimo de respostas por área (~1 km) para aparecer no mapa coletivo.
MIN_RESPOSTAS_CELULA=3
